{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "A volleyball player with stats and ELO",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE", "M", "F"] },
        "isOfficialSetter": { "type": "boolean" },
        "elo": { "type": "integer" },
        "matchesPlayed": { "type": "integer" },
        "dailyMatches": { "type": "integer" },
        "dailyWins": { "type": "integer" },
        "dailyLosses": { "type": "integer" },
        "dailyEloGain": { "type": "integer" },
        "dailyResults": { "type": "array", "items": { "type": "string", "enum": ["V", "D"] } },
        "wins": { "type": "integer" },
        "losses": { "type": "integer" },
        "eloHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "format": "date" },
              "elo": { "type": "integer" }
            }
          }
        },
        "isAdmin": { "type": "boolean" },
        "joinedAt": { "type": "string", "format": "date" },
        "playedLastMatch": { "type": "boolean" },
        "birthDate": { "type": "string", "format": "date" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" },
        "arrivalOrder": { "type": "integer" },
        "isPresent": { "type": "boolean" },
        "timestamp": { "type": "integer" },
        "status": { "type": "string" },
        "createdAt": { "type": "integer" },
        "role": { "type": "string" },
        "position": { "type": "string" },
        "level": { "type": "string" },
        "impactLevel": { "type": "integer", "enum": [1, 2, 3], "description": "1: Base, 2: Medium, 3: Elite" },
        "skills": {
          "type": "object",
          "properties": {
            "setting": { "type": "integer", "enum": [1, 2, 3] },
            "attacking": { "type": "integer", "enum": [1, 2, 3] },
            "defense": { "type": "integer", "enum": [1, 2, 3] },
            "serving": { "type": "integer", "enum": [1, 2, 3] }
          }
        }
      },
      "required": ["id", "name", "gender", "elo"]
    },
    "Payment": {
      "title": "Payment",
      "description": "A monthly membership payment record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "playerId": { "type": "string" },
        "playerName": { "type": "string" },
        "amount": { "type": "number" },
        "month": { "type": "string" },
        "paymentDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["PAID", "PENDING"] }
      },
      "required": ["id", "playerId", "playerName", "amount", "month", "paymentDate", "status"]
    },
    "AppMetadata": {
      "title": "App Metadata",
      "description": "Global settings like synergy and rivalry maps",
      "type": "object",
      "properties": {
        "synergy": { "type": "object" },
        "rivalry": { "type": "object" },
        "lastResetDate": { "type": "string" },
        "matchStartTime": { "type": "integer" },
        "dailyMatchCount": { "type": "integer" },
        "courtLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "geofenceRadius": { "type": "integer" }
      }
    },
    "Match": {
      "title": "Match",
      "description": "A recorded volleyball match result",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "integer" },
        "teamA": { "type": "array", "items": { "type": "string" } },
        "teamB": { "type": "array", "items": { "type": "string" } },
        "scoreA": { "type": "integer" },
        "scoreB": { "type": "integer" },
        "winner": { "type": "string", "enum": ["A", "B"] },
        "duration": { "type": "integer" },
        "mode": { "type": "string", "enum": ["QUICK", "SCORE", "SEQUENTIAL"] }
      },
      "required": ["id", "timestamp", "teamA", "teamB", "winner"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User role and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "MEMBER"] }
      },
      "required": ["uid", "email", "role"]
    },
    "PendingRequest": {
      "title": "PendingRequest",
      "description": "Solicitação de acesso de um novo usuário.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "status"]
    },
    "CurrentMatch": {
      "title": "Current Match",
      "description": "The state of the match currently being played",
      "type": "object",
      "properties": {
        "teamA": { "type": "object" },
        "teamB": { "type": "object" },
        "remainingPlayers": { "type": "array" },
        "startTime": { "type": "integer" },
        "status": { "type": "string", "enum": ["PLAYING", "FINISHED"] }
      }
    },
    "UsageStats": {
      "title": "Usage Stats",
      "description": "Estimated Firestore quota usage for the day",
      "type": "object",
      "properties": {
        "reads": { "type": "integer" },
        "writes": { "type": "integer" },
        "lastUpdate": { "type": "string" }
      }
    },
    "Tournament": {
      "title": "Tournament",
      "description": "A monthly celebration tournament with fixed teams",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "teams": { "type": "array" },
        "matches": { "type": "array" },
        "config": { "type": "object" }
      },
      "required": ["id", "name", "date", "status", "teams", "matches", "config"]
    },
    "Intentions": {
      "title": "Intentions",
      "description": "Weekly intentions for the upcoming game day",
      "type": "object",
      "properties": {
        "targetDate": { "type": "string" },
        "automationEnabled": { "type": "boolean" },
        "responses": { "type": "object" },
        "remindersSent": { "type": "object" }
      }
    },
    "FcmMessage": {
      "title": "FCM Message",
      "description": "A message to be sent via Firebase Cloud Messaging",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "notification": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "body": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Records of system actions like socio updates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "playerId": { "type": "string" },
        "playerName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "performedBy": { "type": "string" },
        "performedByEmail": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "action", "playerId", "timestamp", "performedBy"]
    },
    "LoginLog": {
      "title": "Login Log",
      "description": "Records of login attempts and their status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILURE"] },
        "error": { "type": "string" },
        "device": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "status", "timestamp"]
    },
    "SentinelReport": {
      "title": "Sentinel Report",
      "description": "AI-generated system health report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string", "enum": ["HEALTHY", "WARNING", "CRITICAL"] },
        "report": { "type": "string" },
        "anomaliesFound": { "type": "integer" },
        "autoFixesApplied": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/sentinelReports/{id}": {
      "schema": "SentinelReport",
      "description": "History of AI sentinel scans"
    },
    "/loginLogs/{id}": {
      "schema": "LoginLog",
      "description": "Authentication logs"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "History of administrative actions"
    },
    "/metadata/intentions": {
      "schema": "Intentions",
      "description": "Weekly intentions and automation settings"
    },
    "/fcm_messages/{docId}": {
      "schema": "FcmMessage",
      "description": "Queue for push notifications"
    },
    "/metadata/currentMatch": {
      "schema": "CurrentMatch",
      "description": "The match currently in progress, shared among admins"
    },
    "/metadata/usage": {
      "schema": "UsageStats",
      "description": "Daily estimated Firestore usage stats"
    },
    "/metadata/activeTournament": {
      "schema": "Tournament",
      "description": "The tournament currently in progress"
    },
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Monthly tournaments"
    },
    "/pendingRequests/{requestId}": {
      "schema": "PendingRequest",
      "description": "Solicitações de acesso de novos usuários."
    },
    "/players/{playerId}": {
      "schema": "Player",
      "description": "Collection of all players"
    },
    "/metadata/{key}": {
      "schema": "AppMetadata",
      "description": "Global metadata like synergy and rivalry"
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "History of all matches played"
    },
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profiles with roles"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Membership payment records"
    },
    "/preConfirmations/{playerId}": {
      "schema": "Player",
      "description": "Players who intended to play in the upcoming session (Tue/Wed)"
    },
    "/attendance/{dateKey}/players/{playerId}": {
      "schema": "Player",
      "description": "Players who are physically present at the court on game day"
    }
  }
}
