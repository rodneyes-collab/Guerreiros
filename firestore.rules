rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rodneyes@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if true; // Keeping it permissive for now but explicit
    }

    match /scheduled_messages/{id} {
      allow read, write: if true;
    }

    match /players/{id} {
      allow read, write: if true;
    }

    match /matches/{id} {
      allow read, write: if true;
    }

    match /metadata/{id} {
      allow read, write: if true;
    }

    match /attendance/{date}/players/{id} {
      allow read, write: if true;
    }
    
    match /users/{id} {
      allow read, write: if true;
    }

    match /payments/{id} {
      allow read, write: if true;
    }

    match /expenses/{id} {
      allow read, write: if true;
    }
  }
}
